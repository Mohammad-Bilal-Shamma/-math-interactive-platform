# Required server-side configuration
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE?ssl={"rejectUnauthorized":true}
JWT_SECRET=replace-with-a-long-random-production-secret

# Clerk authentication for React/Vite and Express.
VITE_CLERK_PUBLISHABLE_KEY=pk_live_replace_with_your_publishable_key
CLERK_PUBLISHABLE_KEY=pk_live_replace_with_your_publishable_key
CLERK_SECRET_KEY=sk_live_replace_with_your_secret_key
# Set this only after the intended teacher signs in; it has a user_ prefix.
CLERK_ADMIN_USER_ID=

# Required only while retaining the current Manus OAuth login flow.
# The Vercel callback URL must be registered with that OAuth application.
VITE_APP_ID=
OAUTH_SERVER_URL=
VITE_OAUTH_PORTAL_URL=
OWNER_OPEN_ID=

# Optional: needed only for Manus storage-proxy routes and other Forge-backed features.
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
VITE_FRONTEND_FORGE_API_URL=
VITE_FRONTEND_FORGE_API_KEY=

# Optional analytics. Leave both unset to disable analytics gracefully.
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=
